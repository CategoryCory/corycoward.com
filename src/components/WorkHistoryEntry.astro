---
interface Props {
	startYear: string;
	endYear: string;
	title: string;
	company: string;
	overview: string;
	highlights: string[];
	technologies: string[];
}

const { startYear, endYear, title, company, overview, highlights, technologies } = Astro.props;
---

<li class="role-entry">
	<div class="role-period">{startYear} <span>--</span> {endYear}</div>
	<div class="role-main">
		<div class="role-title-row">
			<h3>{title}</h3>
			<p class="company">{company}</p>
		</div>
		<p class="role-description">{overview}</p>
		{highlights.length > 0 && (
			<details class="role-highlights">
				<summary>
					<span class="read-more-label">Read more</span>
					<span class="read-less-label">Read less</span>
					<span class="disclosure-indicator" aria-hidden="true"></span>
				</summary>
				<ul class="highlights-list" aria-label="Role highlights">
					{highlights.map((highlight) => <li>{highlight}</li>)}
				</ul>
			</details>
		)}
		<ul class="technology-list" aria-label="Technologies used">
			{technologies.map((technology) => <li>{technology}</li>)}
		</ul>
	</div>
</li>