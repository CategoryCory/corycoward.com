---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/project.css';

export async function getStaticPaths() {
	const projects = await getCollection('projects');

	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { description, links, technologies, title, year } = project.data;
---

<BaseLayout title={`${title} | Cory Coward`} description={description} activeNavigation="projects">
		<main class="project-page">
				<a class="back-link" href="/#projects"><span aria-hidden="true">&larr;</span> All projects</a>
				<section class="project-hero" aria-labelledby="project-title">
					<p class="eyebrow"><span></span> PROJECT / {year}</p>
					<h1 id="project-title">{title}</h1>
					<p class="project-lede">{description}</p>
					<div class="project-meta">
						<ul class="technology-list" aria-label={`${title} technologies`}>
							{technologies.map((technology) => <li>{technology}</li>)}
						</ul>
						<div class="project-actions">
							{links.repository && <a href={links.repository} target="_blank" rel="noreferrer">Repository <span aria-hidden="true">&nearr;</span></a>}
							{links.demo && <a href={links.demo} target="_blank" rel="noreferrer">Live demo <span aria-hidden="true">&nearr;</span></a>}
						</div>
					</div>
				</section>

				<article class="project-content">
					<Content />
				</article>
			</main>
</BaseLayout>