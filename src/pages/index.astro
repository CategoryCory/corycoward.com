---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import WorkHistoryEntry from "../components/WorkHistoryEntry.astro";
import { workHistory } from "../content/work/work-history";

const projects = (await getCollection("projects")).sort(
    (first, second) => first.data.sortOrder - second.data.sortOrder,
);
---

<BaseLayout
    title="Cory Coward | Software Engineer"
    description="Cory Coward, backend and embedded software engineer."
>
            <main>
                <section class="intro" aria-labelledby="page-title">
                    <div class="intro-copy">
                        <p class="eyebrow">
                            <span></span> SOFTWARE / HARDWARE
                        </p>
                        <h1 id="page-title">
                            Cory
                            <br />
                            Coward
                        </h1>
                        <p class="role">
                            Backend &amp; embedded software engineer
                        </p>
                        <p class="summary">
                            Building dependable systems where code meets the
                            physical world.
                        </p>
                    </div>
                    <div class="signal-field" aria-hidden="true">
                        <div class="signal-image"></div>
                        <div class="signal-label">
                            SYSTEMS ONLINE
                            <br />
                            <span>EST. 2012</span>
                        </div>
                        <div class="signal-line line-one"></div>
                        <div class="signal-line line-two"></div>
                    </div>
                </section>

                <section
                    class="experience"
                    id="experience"
                    aria-labelledby="experience-title"
                >
                    <div class="section-heading">
                        <p class="eyebrow">
                            <span></span> SELECTED EXPERIENCE
                        </p>
                        <h2 id="experience-title">Work history</h2>
                        <p>
                            Systems built for people, production, and the less
                            forgiving edge cases.
                        </p>
                    </div>

                    <ol class="timeline">
                        {workHistory.map((entry) => (
                            <WorkHistoryEntry {...entry} />
                        ))}
                    </ol>
                </section>

                <section
                    class="projects"
                    id="projects"
                    aria-labelledby="projects-title"
                >
                    <div class="section-heading">
                        <p class="eyebrow">
                            <span></span> SELECTED WORK
                        </p>
                        <h2 id="projects-title">Projects</h2>
                        <p>
                            Experiments, useful tools, and systems built outside
                            the day job.
                        </p>
                    </div>

                    <div class="project-list">
                        {projects.map((project) => (
                            <ProjectCard project={project} />
                        ))}
                    </div>
                </section>

                <section
                    class="about"
                    id="about"
                    aria-labelledby="about-title"
                >
                    <div class="section-heading">
                        <p class="eyebrow"><span></span> ABOUT ME</p>
                        <h2 id="about-title">Making things work.</h2>
                        <p>
                            Thoughtful systems work, a healthy respect for
                            constraints, and an enduring interest in how things
                            are made.
                        </p>
                    </div>

                    <div class="about-copy">
                        <div class="about-primary">
                            <p>
                                I am passionate about making a difference by
                                building and fixing things. My specialty is
                                backend and embedded software engineering, with
                                experience that also reaches into disciplines
                                such as DSP and antenna design.
                            </p>
                            <p>
                                I most enjoy the space where software meets
                                hardware: turning imperfect requirements into
                                optimized, dependable systems that do their job
                                quietly and well.
                            </p>
                        </div>
                        <aside class="about-notes" aria-label="Outside work">
                            <p class="eyebrow"><span></span> OFF THE CLOCK</p>
                            <p>
                                When I am not at a keyboard or a breadboard,
                                you will usually find me playing piano, reading,
                                or watching <em>Seinfeld</em> for the 87th time.
                            </p>
                        </aside>
                    </div>
                </section>
            </main>
</BaseLayout>
