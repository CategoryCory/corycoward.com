---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import WorkHistoryEntry from "../components/WorkHistoryEntry.astro";
import { workHistory } from "../content/work/work-history";

const projects = (await getCollection("projects")).sort(
    (first, second) => first.data.sortOrder - second.data.sortOrder,
);
---

<BaseLayout
    title="Cory Coward | Software Engineer"
    description="Cory Coward, backend and embedded software engineer."
>
            <main>
                <section class="intro" aria-labelledby="page-title">
                    <div class="intro-copy">
                        <p class="eyebrow">
                            <span></span> SOFTWARE / HARDWARE
                        </p>
                        <h1 id="page-title">
                            Cory
                            <br />
                            Coward
                        </h1>
                        <p class="role">
                            Backend &amp; embedded software engineer
                        </p>
                        <p class="summary">
                            Curious about how things work. Particular about how software should work.
                        </p>
                    </div>
                    <div class="signal-field" aria-hidden="true">
                        <div class="signal-image"></div>
                        <!-- div class="signal-label">
                            SYSTEMS ONLINE
                            <br />
                            <span>EST. 2012</span>
                        </div -->
                        <div class="signal-line line-one"></div>
                        <div class="signal-line line-two"></div>
                    </div>
                </section>

                <section
                    class="experience"
                    id="experience"
                    aria-labelledby="experience-title"
                >
                    <div class="section-heading">
                        <p class="eyebrow">
                            <span></span> SELECTED EXPERIENCE
                        </p>
                        <h2 id="experience-title">Work history</h2>
                        <p>
                            Practical software, complex problems, and lessons learned along the way.
                        </p>
                    </div>

                    <ol class="timeline">
                        {workHistory.map((entry) => (
                            <WorkHistoryEntry {...entry} />
                        ))}
                    </ol>
                </section>

                <section
                    class="projects"
                    id="projects"
                    aria-labelledby="projects-title"
                >
                    <div class="section-heading">
                        <p class="eyebrow">
                            <span></span> SELECTED WORK
                        </p>
                        <h2 id="projects-title">Projects</h2>
                        <p>
                            Some useful, some experimental, and some built just to see if I could.
                        </p>
                    </div>

                    <div class="project-list">
                        {projects.map((project) => (
                            <ProjectCard project={project} />
                        ))}
                    </div>
                </section>

                <section
                    class="about"
                    id="about"
                    aria-labelledby="about-title"
                >
                    <div class="section-heading">
                        <p class="eyebrow"><span></span> ABOUT ME</p>
                        <h2 id="about-title">Making things work.</h2>
                        <p>
                            An engineer, a musician, and someone who's always been curious about how things work.
                        </p>
                    </div>

                    <div class="about-copy">
                        <div class="about-primary">
                            <p>
                                I've always been curious about how things work,
                                and I've spent much of my career figuring out how
                                to make them work better. My background is primarily
                                in backend and embedded software engineering, but my
                                interests and experience have taken me into everything
                                from digital signal processing to antenna design.
                            </p>
                            <p>
                                I've always been drawn to the intersection of software
                                and hardware, where abstract ideas meet real-world
                                constraints. I enjoy turning complicated problems and
                                imperfect requirements into dependable systems that do
                                their jobs quietly and well.
                            </p>
                        </div>
                        <aside class="about-notes" aria-label="Outside work">
                            <p class="eyebrow"><span></span> OFF THE CLOCK</p>
                            <p>
                                When I am not at a keyboard or a breadboard,
                                you will usually find me playing piano, reading,
                                or watching <em>Seinfeld</em> for the 87th time.
                            </p>
                        </aside>
                    </div>
                </section>
            </main>
</BaseLayout>
